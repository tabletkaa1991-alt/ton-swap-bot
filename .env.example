# Токен бота из @BotFather. НЕ КОММИТИТЬ. Если попал в чат/лог — /revoke в BotFather.
BOT_TOKEN=

# Ключ tonapi.io: https://tonconsole.com → проект → API keys
TONAPI_KEY=

# mainnet | testnet
NETWORK=testnet

# Комиссия сервиса, % (0–10). Взимается отдельным переводом в TON.
FEE_PERCENT=2.5

# Лимиты одной сделки в долларовом эквиваленте (по курсу на момент обмена)
MIN_USD=1
MAX_USD=5000

# Публичный HTTPS-адрес мини-приложения (кнопка WebApp в боте).
# На Render/Koyeb/Fly можно оставить пустым — адрес определится сам.
# Локально его прописывает start.ps1 после старта туннеля.
WEBAPP_URL=

# Необязательно: порт HTTP-сервера (по умолчанию 8080, хостинги обычно
# подставляют PORT сами) и адрес прослушивания.
# PORT=8080
# HOST=0.0.0.0

# Необязательно: режим вебхука вместо long polling. Полезен, если хостинг
# умеет будить контейнер по входящему запросу (Telegram будет стучаться сам).
# WEBHOOK_URL=https://ваш-домен/telegram/webhook
# WEBHOOK_SECRET=

# Прокси для Telegram API, если api.telegram.org недоступен:
# socks5://user:pass@host:1080 или http://user:pass@host:8080
PROXY_URL=

# Кому писать при ошибках (необязательно)
ADMIN_CHAT_ID=
